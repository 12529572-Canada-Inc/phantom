# Use an allowlist so local state, credentials, generated output, and the
# unrelated mobile dependency tree never enter the API build context.
**

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

!apps/
apps/*
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**

!packages/
packages/*
!packages/types/
!packages/types/package.json
!packages/types/src/
!packages/types/src/**
!packages/typescript-config/
!packages/typescript-config/package.json
!packages/typescript-config/*.json
