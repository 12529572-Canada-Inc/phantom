{
  "expo": {
    "name": "Phantom",
    "slug": "phantom",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "phantom",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Phantom to use your location to center the map and show your position."
        }
      ]
    ]
  }
}
